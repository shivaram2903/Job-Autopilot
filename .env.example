# Optional SMTP email delivery for daily reports
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@example.com
REPORT_EMAIL_TO=you@example.com

# Optional customization
JOBPILOT_TIMEZONE=Asia/Kolkata
# JOBPILOT_DB_PATH=/absolute/path/to/jobpilot.sqlite3

# Optional AI-generated resume and cover letter drafts (explicit user action only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
